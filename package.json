{
  "name": "minhtuan-logistics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "keywords": "node scripts/generate-keywords.js",
    "news": "node scripts/generate-news-posts.js",
    "news:index": "node scripts/generate-news-index.js",
    "validate-news": "node scripts/validate-news.js",
    "validate-seo": "node -e \"const C=require('./lib/seo-checklist'); const p=require('./data/news-posts.json'); let ok=0,bad=0; p.slice(0,5).forEach(x=>{const r=C.analyze(x,{existingPosts:p,currentId:x.id}); console.log(x.slug,r.score,r.canPublish);});\"",
    "articles": "node scripts/generate-article-pages.js",
    "subpages": "node scripts/generate-subpages.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "seo:density": "node scripts/normalize-keyword-density.js",
    "seo:audit": "node scripts/audit-seo.js",
    "seo:money": "node scripts/upgrade-money-pages.js",
    "seo:pillars": "node scripts/upgrade-pillar-posts.js",
    "seo:clean-urls": "node scripts/fix-clean-urls.js",
    "storage:status": "node -e \"require('./lib/env').loadEnv(); const r=require('./lib/r2'); const s=require('./lib/supabase'); s.health().then(h=>console.log(JSON.stringify({r2:r.isConfigured(),supabase:h},null,2)));\"",
    "build": "node scripts/normalize-keyword-density.js && node scripts/generate-news-index.js && node scripts/generate-subpages.js && node scripts/generate-article-pages.js && node scripts/generate-sitemap.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@supabase/supabase-js": "^2.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
